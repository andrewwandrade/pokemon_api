{
  "openapi": "3.0.0",
  "info": {
    "title": "API para gerenciamento de Pokémons",
    "version": "1.0.0",
    "description": "API desenvolvida para a disciplina Tópicos Especiais em Engenharia de Software (UFF)"
  },
  "servers": [
    {
      "url": "http://localhost:3000/"
    }
  ],
  "tags": [
    {
      "name": "Pokemons",
      "description": "Criar, editar, atualizar e listar Pokémons"
    }
  ],
  "paths": {
    "/pokemons": {
      "get": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Lista todos os pokémons",
        "description": "Retorna uma lista de pokémons cadastrados.",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Filtra pokémons pelo tipo (ex: electric, fire, water)",
            "example": "electric",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de pokémons retornada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "example": "1"
                      },
                      "name": {
                        "type": "string",
                        "example": "Pikachu"
                      },
                      "type": {
                        "type": "string",
                        "example": "electric"
                      },
                      "height": {
                        "type": "number",
                        "example": 4
                      },
                      "weight": {
                        "type": "number",
                        "example": 60
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "deprecated": false
      },
      "post": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Cria um novo pokémon",
        "description": "Cadastra um novo pokémon com os dados informados no corpo da requisição.",
        "responses": {
          "201": {
            "description": "Pokémon criado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "example": "1"
                    },
                    "name": {
                      "type": "string",
                      "example": "Pikachu"
                    },
                    "type": {
                      "type": "string",
                      "example": "electric"
                    },
                    "height": {
                      "type": "number",
                      "example": 4
                    },
                    "weight": {
                      "type": "number",
                      "example": 60
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Campos obrigatórios ausentes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Campos obrigatórios ausentes."
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Pikachu"
                  },
                  "type": {
                    "type": "string",
                    "example": "electric"
                  },
                  "height": {
                    "type": "number",
                    "example": 4
                  },
                  "weight": {
                    "type": "number",
                    "example": 60
                  }
                },
                "required": [
                  "name",
                  "type",
                  "height",
                  "weight"
                ]
              }
            }
          }
        },
        "deprecated": false
      }
    },
    "/pokemons/{id}": {
      "get": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Busca um pokémon pelo ID",
        "description": "Retorna os dados de um único pokémon a partir do seu ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do pokémon",
            "example": "1"
          }
        ],
        "responses": {
          "200": {
            "description": "Pokémon encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "example": "1"
                    },
                    "name": {
                      "type": "string",
                      "example": "Pikachu"
                    },
                    "type": {
                      "type": "string",
                      "example": "electric"
                    },
                    "height": {
                      "type": "number",
                      "example": 4
                    },
                    "weight": {
                      "type": "number",
                      "example": 60
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "ID inválido",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "ID inválido."
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Pokémon não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Pokémon não encontrado"
                    }
                  }
                }
              }
            }
          }
        },
        "deprecated": false
      },
      "put": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Atualiza dados de um Pokémon",
        "description": "Altera as informações de um Pokémon existente pelo seu ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do Pokémon a ser atualizado"
          }
        ],
        "responses": {
          "200": {
            "description": "Pokémon atualizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "example": "1"
                    },
                    "name": {
                      "type": "string",
                      "example": "Raichu"
                    },
                    "type": {
                      "type": "string",
                      "example": "electric"
                    },
                    "height": {
                      "type": "number",
                      "example": 8
                    },
                    "weight": {
                      "type": "number",
                      "example": 300
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "ID inválido",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "ID inválido."
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Pokémon não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Pokémon não encontrado"
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Raichu"
                  },
                  "type": {
                    "type": "string",
                    "example": "electric"
                  },
                  "height": {
                    "type": "number",
                    "example": 8
                  },
                  "weight": {
                    "type": "number",
                    "example": 300
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Remove um Pokémon do catálogo",
        "description": "Exclui permanentemente um Pokémon do registro local.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do Pokémon a ser excluído"
          }
        ],
        "responses": {
          "204": {
            "description": "Pokémon excluído com sucesso (sem conteúdo)"
          },
          "400": {
            "description": "ID inválido",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "ID inválido."
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Pokémon não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Pokémon não encontrado"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Pokemon": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "1"
          },
          "name": {
            "type": "string",
            "example": "Pikachu"
          },
          "type": {
            "type": "string",
            "example": "Electric"
          },
          "height": {
            "type": "number",
            "example": 0.4
          },
          "weight": {
            "type": "number",
            "example": 6
          }
        }
      },
      "PokemonInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Pikachu"
          },
          "type": {
            "type": "string",
            "example": "Electric"
          },
          "height": {
            "type": "number",
            "example": 0.4
          },
          "weight": {
            "type": "number",
            "example": 6
          }
        }
      }
    }
  }
}