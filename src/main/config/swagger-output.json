{
  "openapi": "3.0.0",
  "info": {
    "title": "API para gerenciamento de Pokémons",
    "version": "1.0.0",
    "description": "API desenvolvida para a disciplina Tópicos Especiais em Engenharia de Software (UFF)"
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/v1"
    }
  ],
  "tags": [
    {
      "name": "Pokemons",
      "description": "Criar, editar, atualizar e listar Pokémons"
    },
    {
      "name": "Trainers",
      "description": "Cadastro de treinadores e consulta do time ativo"
    }
  ],
  "paths": {
    "/pokemons": {
      "get": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Lista todos os pokémons",
        "description": "Retorna uma lista de pokémons cadastrados.",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Filtra pokémons pelo tipo (ex: electric, fire, water)",
            "example": "electric",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de pokémons retornada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "example": "1"
                      },
                      "name": {
                        "type": "string",
                        "example": "Pikachu"
                      },
                      "type": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "example": [
                          "electric"
                        ]
                      },
                      "height": {
                        "type": "number",
                        "example": 4
                      },
                      "weight": {
                        "type": "number",
                        "example": 60
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "deprecated": false
      },
      "post": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Cria um novo pokémon",
        "description": "Cadastra um novo pokémon com os dados informados no corpo da requisição.",
        "responses": {
          "201": {
            "description": "Pokémon criado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "example": "1"
                    },
                    "name": {
                      "type": "string",
                      "example": "Pikachu"
                    },
                    "type": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "example": [
                        "electric"
                      ]
                    },
                    "height": {
                      "type": "number",
                      "example": 4
                    },
                    "weight": {
                      "type": "number",
                      "example": 60
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Campos obrigatórios ausentes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Campos obrigatórios ausentes."
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Pikachu"
                  },
                  "type": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "example": [
                      "electric"
                    ]
                  },
                  "height": {
                    "type": "number",
                    "example": 4
                  },
                  "weight": {
                    "type": "number",
                    "example": 60
                  }
                },
                "required": [
                  "name",
                  "type",
                  "height",
                  "weight"
                ]
              }
            }
          }
        },
        "deprecated": false
      }
    },
    "/pokemons/{id}": {
      "get": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Busca um pokémon pelo ID",
        "description": "Retorna os dados de um único pokémon a partir do seu ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do pokémon",
            "example": "1"
          }
        ],
        "responses": {
          "200": {
            "description": "Pokémon encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "example": "1"
                    },
                    "name": {
                      "type": "string",
                      "example": "Pikachu"
                    },
                    "type": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "example": [
                        "electric"
                      ]
                    },
                    "height": {
                      "type": "number",
                      "example": 4
                    },
                    "weight": {
                      "type": "number",
                      "example": 60
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "ID inválido",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "ID inválido."
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Pokémon não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Pokémon não encontrado"
                    }
                  }
                }
              }
            }
          }
        },
        "deprecated": false
      },
      "put": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Atualiza dados de um Pokémon",
        "description": "Altera as informações de um Pokémon existente pelo seu ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do Pokémon a ser atualizado"
          }
        ],
        "responses": {
          "200": {
            "description": "Pokémon atualizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "example": "1"
                    },
                    "name": {
                      "type": "string",
                      "example": "Raichu"
                    },
                    "type": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "example": [
                        "electric"
                      ]
                    },
                    "height": {
                      "type": "number",
                      "example": 8
                    },
                    "weight": {
                      "type": "number",
                      "example": 300
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "ID inválido",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "ID inválido."
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Pokémon não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Pokémon não encontrado"
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Raichu"
                  },
                  "type": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "example": [
                      "electric"
                    ]
                  },
                  "height": {
                    "type": "number",
                    "example": 8
                  },
                  "weight": {
                    "type": "number",
                    "example": 300
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Remove um Pokémon do catálogo",
        "description": "Exclui permanentemente um Pokémon do registro local.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do Pokémon a ser excluído"
          }
        ],
        "responses": {
          "204": {
            "description": "Pokémon excluído com sucesso (sem conteúdo)"
          },
          "400": {
            "description": "ID inválido",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "ID inválido."
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Pokémon não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Pokémon não encontrado"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/trainers": {
      "post": {
        "tags": [
          "Trainers"
        ],
        "summary": "Cadastra um novo treinador",
        "description": "Cria um treinador. O e-mail deve ser único.",
        "responses": {
          "201": {
            "description": "Treinador criado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "example": "3f2b8c1e-7a4d-4e1a-9c55-0d6f2a8b1e10"
                    },
                    "name": {
                      "type": "string",
                      "example": "Ash Ketchum"
                    },
                    "email": {
                      "type": "string",
                      "example": "ash@pallet.com"
                    },
                    "createdAt": {
                      "type": "string",
                      "example": "2026-10-12T15:30:00.000Z"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dados de entrada inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Dados de entrada inválidos"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "E-mail já cadastrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Já existe um treinador com esse e-mail"
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Ash Ketchum"
                  },
                  "email": {
                    "type": "string",
                    "example": "ash@pallet.com"
                  }
                },
                "required": [
                  "name",
                  "email"
                ]
              }
            }
          }
        },
        "deprecated": false
      }
    },
    "/trainers/{trainerId}/team": {
      "get": {
        "tags": [
          "Trainers"
        ],
        "summary": "Lista o time ativo do treinador",
        "description": "Retorna os Pokémons capturados que estão no time ativo (máximo de 6).",
        "parameters": [
          {
            "name": "trainerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID (UUID) do treinador",
            "example": "3f2b8c1e-7a4d-4e1a-9c55-0d6f2a8b1e10"
          }
        ],
        "responses": {
          "200": {
            "description": "Time ativo do treinador",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "example": "9a1d4c7e-2b3f-4a6d-8e90-1c2d3e4f5a6b"
                      },
                      "trainerId": {
                        "type": "string",
                        "example": "3f2b8c1e-7a4d-4e1a-9c55-0d6f2a8b1e10"
                      },
                      "pokedexId": {
                        "type": "integer",
                        "example": 25
                      },
                      "name": {
                        "type": "string",
                        "example": "pikachu"
                      },
                      "imageUrl": {
                        "type": "string",
                        "example": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/25.png"
                      },
                      "types": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "example": [
                          "electric"
                        ]
                      },
                      "stats": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string",
                              "example": "hp"
                            },
                            "value": {
                              "type": "integer",
                              "example": 35
                            }
                          }
                        }
                      },
                      "isActive": {
                        "type": "boolean",
                        "example": true
                      },
                      "capturedAt": {
                        "type": "string",
                        "example": "2026-10-12T15:30:00.000Z"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Treinador não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Treinador não encontrado(a)"
                    }
                  }
                }
              }
            }
          }
        },
        "deprecated": false
      }
    }
  },
  "components": {
    "schemas": {
      "Pokemon": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "1"
          },
          "name": {
            "type": "string",
            "example": "Pikachu"
          },
          "type": {
            "type": "string",
            "example": "Electric"
          },
          "height": {
            "type": "number",
            "example": 0.4
          },
          "weight": {
            "type": "number",
            "example": 6
          }
        }
      },
      "PokemonInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Pikachu"
          },
          "type": {
            "type": "string",
            "example": "Electric"
          },
          "height": {
            "type": "number",
            "example": 0.4
          },
          "weight": {
            "type": "number",
            "example": 6
          }
        }
      }
    }
  }
}